# ============================================================
#  TrueBellaa backend — environment configuration
#  Copy this file to ".env" and fill in real values.
#  NEVER commit the real .env to git.
# ============================================================

# --- App ---
APP_NAME=TrueBellaa API
ENV=development                 # development | production
DEBUG=true

# --- Security ---
# Generate a long random string:  python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Database (EASY WAY — just fill these 5) ---
# No URL, no escaping. A password with special characters works fine here.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=truebellaa
#   * Standard MySQL/XAMPP runs on port 3306.
#   * If your MySQL root password is (for example) 1234, write:  DB_PASSWORD=1234
#   * No password? leave DB_PASSWORD blank.

# --- Database (ADVANCED — optional) ---
# Only set these if you use a separate READ REPLICA or a full custom URL.
# If set, they OVERRIDE the 5 fields above. Leave blank otherwise.
DATABASE_PRIMARY_URL=mysql+pymysql://root:Root%401234@127.0.0.1:3300/truebellaa?charset=utf8mb4
DATABASE_REPLICA_URL=mysql+pymysql://root:Root%401234@127.0.0.1:3300/truebellaa?charset=utf8mb4

# --- Razorpay ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
# When keys are placeholders, the app runs payments in DEMO mode (like the frontend).

# --- Shiprocket ---
SHIPROCKET_EMAIL=you@example.com
SHIPROCKET_PASSWORD=your_shiprocket_password
SHIPROCKET_PICKUP_LOCATION=Primary
# When credentials are blank, shipping runs in DEMO mode.

# --- MilesWeb file storage (product image uploads) ---
# Find these in mPanel -> Files -> FTP Accounts (or your hosting welcome email).
# FTP_BASE_DIR should match the folder shown in mPanel's File Manager
# (e.g. the "Images" folder under Storage in your screenshot).
FTP_HOST=ftp.yourdomain.com
FTP_PORT=21
FTP_USER=your_ftp_username
FTP_PASSWORD=your_ftp_password
FTP_USE_TLS=false
FTP_BASE_DIR=/Images
FTP_PUBLIC_BASE_URL=https://truebellaa.in/Images
MAX_IMAGE_SIZE_MB=8
# When FTP_HOST/FTP_USER/FTP_PASSWORD are left as placeholders, uploads are
# saved to a local "uploads/products" folder and served by this API itself
# (DEMO mode) — so image upload works end-to-end before MilesWeb is wired up.

# --- Email (SMTP) ---
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=587
SMTP_USER=support@yourdomain.com
SMTP_PASSWORD=your_email_password
SMTP_FROM_NAME=TrueBellaa
# When the password is a placeholder, emails are logged to the console instead of sent (DEMO mode).

# --- CORS (the storefront / admin origins allowed to call this API) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
