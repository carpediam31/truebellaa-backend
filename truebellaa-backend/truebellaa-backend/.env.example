# ============================================================
#  TrueBellaa backend — environment configuration
#  Copy this file to ".env" and fill in real values.
#  NEVER commit the real .env to git.
# ============================================================

# --- App ---
APP_NAME=TrueBellaa API
ENV=development                 # development | production
DEBUG=true

# --- Security ---
# Generate a long random string:  python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Database (EASY WAY — just fill these 5) ---
# No URL, no escaping. A password with special characters works fine here.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=truebellaa
#   * Standard MySQL/XAMPP runs on port 3306.
#   * If your MySQL root password is (for example) 1234, write:  DB_PASSWORD=1234
#   * No password? leave DB_PASSWORD blank.

# --- Database (ADVANCED — optional) ---
# Only set these if you use a separate READ REPLICA or a full custom URL.
# If set, they OVERRIDE the 5 fields above. Leave blank otherwise.
DATABASE_PRIMARY_URL=
DATABASE_REPLICA_URL=

# --- Razorpay ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
# When keys are placeholders, the app runs payments in DEMO mode (like the frontend).

# --- Shiprocket ---
SHIPROCKET_EMAIL=you@example.com
SHIPROCKET_PASSWORD=your_shiprocket_password
SHIPROCKET_PICKUP_LOCATION=Primary
# When credentials are blank, shipping runs in DEMO mode.

# --- CORS (the storefront / admin origins allowed to call this API) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
